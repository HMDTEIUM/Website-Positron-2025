modules = ["php-8.2", "web", "nodejs-20"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
mode = "sequential"
author = 19599294

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web-positron-main && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web-positron-main && php artisan serve --host=0.0.0.0 --port=5000"
